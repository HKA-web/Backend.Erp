<?php

namespace Modules\{{module}}\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Services\BaseService;
use Modules\{{module}}\Models\{{model}};
use Illuminate\Http\Request;

class {{model}}Controller extends Controller
{
    public function __construct(protected readonly BaseService $baseService) {}

    public function index()
    {
        return $this->erpExecution(function () {
            return $this->erpResponse({{model}}::query(), tags: ['{{model_lower}}']);
        });
    }

    public function show($id)
    {
        return $this->erpExecution(function () use ($id) {
            $query = {{model}}::where('{{model_lower}}_id', $id);
            return $this->erpResponse($query, tags: ['{{model_lower}}']);
        });
    }

    public function revise($id)
    {
        return $this->erpExecution(function () use ($id) {

            $this->baseService->executeProcedure('{{module_lower}}.procedure_revise_{{model_lower}}', [
                '{{model_lower}}_id' => $id
            ]);

            return $this->erpResponse(
                message: "{{model}} {$id} has been moved to drafts for revision."
            );
        }, "Failed to initiate revision for {{model}}.");
    }

    public function destroy($id)
    {
        return $this->erpExecution(function () use ($id) {

            $this->baseService->requestDelete({{model}}::class, $id, '{{module_lower}}.procedure_revise_{{model_lower}}');

            return $this->erpResponse(
                message: "Delete request for {{model}} {$id} processed according to model policy."
            );

        }, "Failed to process delete request for {{model}}.");
    }
}
