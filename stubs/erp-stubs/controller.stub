    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy({{model}}Request $request, $id, BaseStaging $staging)
    {
        return $this->erpExecution(function () use ($staging, $request, $id) {

            $validated = $request->validated();

            $payload = array_merge($validated, [
                '{{model_lower}}_id' => $id,
                'is_removed' => true
            ]);

            $staging->executeStaging('{{module_lower}}.procedure_action_{{model_lower}}', $payload);

            return $this->erpResponse(
                message: "{{model}} {$id} ready for delete."
            );

        }, 'Failed to delete {{model}}.');
    }
}
