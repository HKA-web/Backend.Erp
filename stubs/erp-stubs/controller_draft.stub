<?php

namespace Modules\{{module}}\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Services\BaseService;
use Modules\{{module}}\Http\Requests\{{model}}Request;
use Illuminate\Support\Facades\DB;

class {{model}}DraftController extends Controller
{
    public function __construct(protected readonly BaseService $baseService) {}

    public function index()
    {
        return $this->erpExecution(function () {
            // Membaca langsung dari tabel temporary
            $query = DB::table('temporary.{{module_lower}}_{{model_lower}}');
            return $this->erpResponse($query);
        });
    }

    public function store({{model}}Request $request)
    {
        return $this->erpExecution(function () use ($request) {
            $this->baseService->executeProcedure('{{module_lower}}.procedure_upsert_{{model_lower}}_draft', $request->validated());

            return $this->erpResponse(
                message: "Draft {{model}} saved successfully."
            );
        });
    }

    public function show($id)
    {
        return $this->erpExecution(function () use ($id) {
            $draft = DB::table('temporary.{{module_lower}}_{{model_lower}}')
                ->where('temporary_id', $id);

            return $this->erpResponse($draft);
        });
    }

    public function update({{model}}Request $request, $id)
    {
        return $this->erpExecution(function () use ($request, $id) {
            $payload = array_merge($request->validated(), ['temporary_id' => $id]);

            $this->baseService->executeProcedure('{{module_lower}}.procedure_upsert_{{model_lower}}_draft', $payload);

            return $this->erpResponse(message: "Draft updated.");
        });
    }

    public function destroy($id)
    {
        return $this->erpExecution(function () use ($id) {
            DB::table('temporary.{{module_lower}}_{{model_lower}}')
                ->where('temporary_id', $id)
                ->delete();

            return $this->erpResponse(message: "Draft discarded.");
        });
    }

    public function commit($id)
    {
        return $this->erpExecution(function () use ($id) {
            $payload = [
                'temporary_id' => $id,
                '{{model_lower}}_id'  => request()->input('{{model_lower}}_id')
            ];

            $this->baseService->executeProcedure('{{module_lower}}.procedure_commit_{{model_lower}}', $payload, {{model}}::class);

            return $this->erpResponse(
                message: "{{model}} committed to master successfully.",
                tags: ['{{model_lower}}']
            );
        }, "Failed to commit draft.");
    }
}
