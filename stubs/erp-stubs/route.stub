// Routes for {{module}}/{{model}}
Route::middleware(['auth:sanctum'])->prefix('v1')->group(function () {
    // Master
    Route::prefix('{{module_lower}}/{{model_lower}}')->controller({{model}}Controller::class)->group(function () {
        Route::get('/', 'index');
        Route::get('/{id}', 'show');
        Route::put('/{id}/revise', 'revise');
        Route::delete('/{id}', 'destroy');
    });

    // Temporary
    Route::prefix('{{module_lower}}/{{model_lower}}-drafts')->controller({{model}}DraftController::class)->group(function () {
        Route::get('/', 'index');
        Route::post('/', 'store');
        Route::get('/{id}', 'show');
        Route::post('/{id}', 'update');
        Route::delete('/{id}', 'destroy');
        Route::post('/{id}/commit', 'commit');
    });
});
