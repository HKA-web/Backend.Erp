// Routes for {{module}}/{{model}}
Route::middleware(['auth:sanctum'])->prefix('v1')->group(function () {
    // Master
    Route::prefix('{{module_lower}}/{{model_lower}}')->group(function () {
        Route::get('/', [{{model}}Controller::class, 'index']);
        Route::get('/{id}', [{{model}}Controller::class, 'show']);
        Route::post('/{id}/revise', [{{model}}Controller::class, 'revise']);
        Route::delete('/{id}', [{{model}}Controller::class, 'destroy']);
    });

    // Temporary
    Route::prefix('{{module_lower}}/{{model_lower}}-drafts')->group(function () {
        Route::get('/', [{{model}}DraftController::class, 'index']);
        Route::post('/', [{{model}}DraftController::class, 'store']);
        Route::get('/{id}', [{{model}}DraftController::class, 'show']);
        Route::put('/{id}', [{{model}}DraftController::class, 'update']);
        Route::delete('/{id}', [{{model}}DraftController::class, 'destroy']);
        Route::post('/{id}/commit', [{{model}}DraftController::class, 'commit']);
    });
});
