<?php

namespace Modules\{{module}}\Database\Factories\Tenant;

use Illuminate\Database\Eloquent\Factories\Factory;
use Illuminate\Support\Str;
use Modules\{{module}}\Models\{{model}};

class {{model}}Factory extends Factory
{
    protected $model = {{model}}::class;

    public function definition(): array
    {
        $modelUpper = strtoupper('{{model}}');
        $moduleUpper = strtoupper('{{module}}');
        
        \Modules\Core\Models\Sequence::firstOrCreate(
            ['sequence_name' => $modelUpper],
            [
                'sequence_id' => Str::uuid(),
                'prefix' => "{$modelUpper}-{YYYY}{MM}-",
                'suffix' => "-{$moduleUpper}",
                'padding' => 4,
                'current_number' => 0,
                'reset_type' => 'MONTHLY',
                'last_reset_date' => now(),
            ]
        );

        return [
            '{{model_lower}}_id'   => Str::uuid(),
            '{{model_lower}}_name' => fake()->name(),
        ];
    }
}
